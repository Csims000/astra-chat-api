{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astra-chat-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  "durable_objects": {
    "bindings": [{ "name": "CHAT_ROOM", "class_name": "ChatRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }]
}